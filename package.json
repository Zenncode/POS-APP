{
  "name": "pos-app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "vite dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json",
    "lint": "eslint app tests",
    "lint:fix": "eslint app tests --fix",
    "test:unit": "node --test tests/unit/format.test.ts tests/unit/posRules.test.ts",
    "test:components": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:regression": "playwright test --grep @regression"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "@react-router/node": "^8",
    "@react-router/serve": "^8",
    "isbot": "^5.1.36",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "^8",
    "socket.io-client": "^4.8.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@react-router/dev": "^8",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.0.3",
    "vitest": "^5.0.0"
  }
}
